# Copy to terraform.tfvars (git-ignored) and adjust.
aws_region = "eu-central-1"
env        = "dev"
# profile  = "my-aws-profile"   # omit to use the default credential chain

# Your own public IP: the only address that can open the wg-easy admin UI.
admin_cidr = "203.0.113.10/32"

# zones = ["team-a", "team-b"]

# Optional, off when not set:
# backup_retention_days = 7                    # daily snapshots of the data volume
# alarm_email           = "you@example.com"    # instance down, disk full, S3 budget alerts
