ENV_FILE=env.aws
# Copy to env.aws (git-ignored). A real test bucket with folders team-a/ and team-b/ in it.
ARCHIVE_BUCKET=CHANGE-ME-bucket-name
RCLONE_CONFIG_ARCHIVE_TYPE=s3
RCLONE_CONFIG_ARCHIVE_PROVIDER=AWS
RCLONE_CONFIG_ARCHIVE_REGION=eu-central-1
RCLONE_CONFIG_ARCHIVE_ACCESS_KEY_ID=CHANGE-ME
RCLONE_CONFIG_ARCHIVE_SECRET_ACCESS_KEY=CHANGE-ME
